# ==============================================================================
# ApplyCopilot — Application Environment Template
# Copy to applyCopilotDev/.env (or applyCopilot/.env) and replace placeholders.
# NEVER commit .env files or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL on 127.0.0.1:5432)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:5432/applycopilot_dev

# ------------------------------------------------------------------------------
# Authentication (NextAuth v5)
# ------------------------------------------------------------------------------
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3100
AUTH_SECRET=replace-with-auth-secret
NEXTAUTH_SECRET=replace-with-nextauth-secret
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# Centralized LiteLLM Gateway (Chat & Structured JSON)
# ------------------------------------------------------------------------------
# OpenAI-compatible base URL for the centralized LiteLLM proxy (infra/litellm/)
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# Server-side project virtual key provisioned by infra/litellm/scripts/bootstrap.sh
# (e.g. LITELLM_KEY_APPLYCOPILOT_DEV for dev, LITELLM_KEY_APPLYCOPILOT for prd).
# SECURITY: Always use a scoped virtual key here — NEVER LITELLM_MASTER_KEY,
# and NEVER expose this key via NEXT_PUBLIC_* variables.
LITELLM_API_KEY=sk-replace-with-project-virtual-key

# Per-request timeout in milliseconds for LiteLLM /chat/completions calls (default: 60000)
LITELLM_TIMEOUT_MS=60000

# Optional comma-separated AIRouteId list forced onto the local-only alias
# (e.g. "jobs.classification,profile.skillAlias"). Leave empty to route all
# Chat/JSON calls through chat-free (which falls back to local-only on exhaustion).
LITELLM_LOCAL_ROUTES=

# ------------------------------------------------------------------------------
# Legacy Embedding Providers (Preserved for 768d embeddings until APC-45)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.1:8b
GEMINI_API_KEY=replace-with-gemini-api-key

# ------------------------------------------------------------------------------
# Runtime & Logging
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
DEBUG_SAVE_EXTRACTED_TEXT=false

# ------------------------------------------------------------------------------
# Notifications (Optional)
# ------------------------------------------------------------------------------
RESEND_API_KEY=replace-with-resend-api-key
FROM_EMAIL=noreply@example.com
TWILIO_ACCOUNT_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_WHATSAPP_NUMBER=
