# Google Gemini API Key
GOOGLE_API_KEY=your_api_key_here

# Database Configuration (Docker Compose: mongodb://localhost:27017/applycopilot)
DATABASE_URL=mongodb://localhost:27017/applycopilot

# Redis Configuration (Docker Compose: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Ollama Configuration (Docker Compose: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-in-production

# Environment
ENV=development
NODE_ENV=development

# Scraping Settings
HEADLESS_MODE=true
SCRAPING_TIMEOUT=30
