# ApplyCopilot Environment Variables Example
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL="mongodb://localhost:27017/applycopilot"

# Authentication Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# AI Services Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Premium AI Services (optional)
GEMINI_API_KEY="your-gemini-api-key-here"

# Development Configuration
NODE_ENV="development"

# Resend
RESEND_API_KEY=resend_xxx
FROM_EMAIL=onboarding@yourdomain.com
 
# Twilio
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_NUMBER=+1234567890