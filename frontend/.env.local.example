# ApplyCopilot Local Development Environment
# This file contains sensitive local development settings
# DO NOT commit this file to version control

# Override production settings for local development
NODE_ENV="development"

# Local MongoDB instance
DATABASE_URL="mongodb://localhost:27017/applycopilot"

# Development authentication secret (change for local development)
NEXTAUTH_SECRET="dev-secret-key-not-for-production"

# Local Ollama instance
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# Optional: Add your Gemini API key for premium AI features
# GEMINI_API_KEY="your-actual-gemini-api-key-here"

# Development overrides
NEXTAUTH_URL="http://localhost:3000"
