// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User Authentication and Profile
model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  passwordHash    String
  name            String
  avatar          String?
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  profile         UserProfile?
  applications    Application[]
  portalConfigs   PortalConfig[]
  searchQueries   SearchQuery[]
  sessions        Session[]
  jobMatches      JobMatch[]
  notificationQueue NotificationQueue[]
  notificationLogs  NotificationLog[]
  notificationPreferences UserNotificationPreferences?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserProfile {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Basic Information
  firstName       String?
  lastName        String?
  title           String?
  summary         String?
  location        String?
  phone           String?
  website         String?
  github          String?

  // Relations
  experiences     Experience[]
  education       Education[]
  projects        Project[]
  skills          Skill[]
  references      Reference[]
  summaries       ProfileSummary[]

  // AI Processing
  vectorEmbedding Json?      // TensorFlow.js compatibility vectors
  processingStatus ProcessingStatus @default(PENDING)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Experience {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  company         String
  position        String
  startDate       DateTime
  endDate         DateTime?
  current         Boolean   @default(false)
  description     String[]
  technologies    String[]
  freeFormContext String?
  
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@map("experiences")
}

model Education {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  institution     String
  degree          String
  field           String?
  startDate       DateTime
  endDate         DateTime?
  current         Boolean   @default(false)
  gpa             String?
  achievements    String[]
  description     String[]
  freeFormContext String?
  
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@map("education")
}

model Project {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  name            String
  description     String[]
  bulletPoints    String[]
  technologies    String[]
  startDate       DateTime
  endDate         DateTime?
  url             String?
  freeFormContext String?
  
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@map("projects")
}

model Skill {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  name            String
  category        SkillCategory
  proficiency     ProficiencyLevel
  yearsExperience  Int?
  
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@unique([profileId, name])
  @@map("skills")
}

model Reference {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  name            String
  position        String?
  company         String?
  email           String?
  phone           String?
  relationship    String
  canContact      Boolean   @default(false)
  notes           String?

  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("references")
}

model ProfileSummary {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  profileId       String    @db.ObjectId
  title           String
  content         String
  isAIGenerated   Boolean   @default(false)
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_summaries")
}

// Job Portal and Listings
model PortalConfig {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  name            String
  type            PortalType
  url             String?
  enabled         Boolean   @default(true)
  
  // Scraping Configuration
  selectors       Json?      // CSS selectors for data extraction
  headers         Json?      // Custom headers for requests
  rateLimit       Int?       // Requests per minute
  
  // Relations
  jobListings     JobListing[]
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("portal_configs")
}

model JobListing {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  portalId        String    @db.ObjectId
  externalId      String    // Portal-specific job ID
  
  // Basic Job Information
  title           String
  company         String
  location        String?
  remote          Boolean   @default(false)
  type            EmploymentType
  description     String
  requirements    String[]
  responsibilities String[]
  technologies    String[]
  salary          Json?     // Min/max, currency
  url             String
  postedAt        DateTime
  expiresAt       DateTime?
  
  // AI Processing
  vectorEmbedding Json?      // TensorFlow.js compatibility vectors
  processingStatus ProcessingStatus @default(PENDING)
  
  // Relations
  portal          PortalConfig @relation(fields: [portalId], references: [id], onDelete: Cascade)
  matches         JobMatch[]
  applications    Application[]
  
  @@unique([portalId, externalId])
  @@map("job_listings")
}

model JobMatch {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  jobListingId    String    @db.ObjectId
  
  // Compatibility Scoring
  overallScore     Float     // 0-100 overall compatibility
  skillsScore     Float?     // Skills matching score
  experienceScore Float?     // Experience relevance score
  educationScore  Float?     // Education matching score
  
  // AI Analysis
  analysis        Json?      // Detailed AI analysis results
  suggestions     String[]   // AI-generated improvement suggestions
  
  // Metadata
  calculatedAt    DateTime  @default(now())
  algorithm       String    @default("tensorflow-cosine")
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListing      JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  
  @@unique([userId, jobListingId])
  @@map("job_matches")
}

// Application Tracking
model Application {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  jobListingId    String    @db.ObjectId
  status          ApplicationStatus @default(SAVED)
  notes           String?
  cvVersion       Json?      // CV version used for application
  coverLetter     String?    // AI-generated cover letter
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  lastUpdated     DateTime  @updatedAt
  nextSteps       String?
  followUpDate    DateTime?

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListing      JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  interviewStages InterviewStage[]
  statusHistory   StatusChange[]

  @@unique([userId, jobListingId])
  @@map("applications")
}

model InterviewStage {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  applicationId   String    @db.ObjectId

  stage           InterviewType
  scheduledAt     DateTime?
  completedAt     DateTime?
  status          StageStatus @default(SCHEDULED)
  notes           String?
  feedback        String?

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interview_stages")
}

model StatusChange {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  applicationId   String    @db.ObjectId

  status          ApplicationStatus
  changedAt       DateTime  @default(now())
  notes           String?

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("status_changes")
}

model Session {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  token           String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model PasswordResetToken {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  token           String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// Enums
enum SkillCategory {
  TECHNICAL
  SOFT_SKILL
  LANGUAGE
  FRAMEWORK
  TOOL
  DOMAIN
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  VIEWED
  INTERVIEW
  TECHNICAL_TEST
  OFFER
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  FINAL_ROUND
  CULTURAL_FIT
}

enum StageStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PortalType {
  WEREMOTE
  LINKEDIN
  INDEED
  GLASSDOOR
  CUSTOM
}

model SearchQuery {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId

  // Search Criteria
  title           String    // Name of the search profile (e.g., "Frontend Senior Remote")
  keywords        String[]  // Keywords for the search engines
  
  // Weighted Profile (stored as JSON arrays of { name: string, weight: number })
  targetTitles    Json?     // Preferred job titles with weights
  hardSkills      Json?     // Technical skills with weights
  softSkills      Json?     // Soft skills with weights
  
  experienceLevel ExperienceLevel
  technologies    String[]  // Legacy/Basic tags

  // Filters
  remoteOnly      Boolean   @default(false)
  salaryMin       Int?
  salaryMax       Int?
  locations       String[]

  // Portal Selection
  portalIds       String[]

  // Search Settings
  isActive        Boolean   @default(true)
  lastRun         DateTime?
  frequency       SearchFrequency

  // Search Status and Progress
  status          ProcessingStatus @default(PENDING)
  funnelStage     Int              @default(0) // 0: None, 1: Preliminary, 2: Deep Scrape, 3: Fine Match, 4: AI Analysis
  totalFound      Int              @default(0)
  processedCount  Int              @default(0)
  error           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("search_queries")
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
}

enum SearchFrequency {
  DAILY
  WEEKLY
  MANUAL
}

// Notification System
model NotificationQueue {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId

  // Notification Content
  type            NotificationType
  channel         NotificationChannel
  status          QueueStatus        @default(PENDING)

  // Recipient Data
  email           String?
  phone           String?

  // Message Content
  subject         String?
  body            String
  template        String?           // Template name if using templates
  variables       Json?             // Template variables

  // Retry Logic
  attempts        Int               @default(0)
  maxAttempts     Int               @default(3)
  lastError       String?
  nextRetryAt     DateTime?

  // Scheduling
  scheduledAt     DateTime?         // For delayed notifications
  processedAt     DateTime?
  deliveredAt     DateTime?

  // Fallback
  fallbackChannel NotificationChannel?
  fallbackSent    Boolean           @default(false)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([userId, createdAt])
  @@map("notification_queue")
}

model NotificationLog {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  queueId         String?   @db.ObjectId

  // Notification Details
  type            NotificationType
  channel         NotificationChannel
  status          DeliveryStatus

  // Recipient
  recipient       String            // Email or phone number

  // Content Summary
  subject         String?
  bodyPreview     String            // First 200 chars for audit

  // Delivery Tracking
  sentAt          DateTime          @default(now())
  deliveredAt     DateTime?
  openedAt        DateTime?
  bouncedAt       DateTime?
  bounceReason    String?

  // Error Tracking
  error           String?
  retryCount      Int               @default(0)

  // Provider Response
  providerMessageId String?           // Resend/Twilio message ID
  providerResponse  Json?             // Full provider response

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([status, sentAt])
  @@index([type, sentAt])
  @@map("notification_logs")
}

model UserNotificationPreferences {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @db.ObjectId

  // Channel Preferences
  emailEnabled    Boolean           @default(true)
  whatsappEnabled Boolean           @default(false)
  whatsappNumber  String?

  // Frequency Settings
  jobMatchFrequency NotificationFrequency @default(DIGEST)
  digestDay       Int?                // 0-6 for Sunday-Saturday
  digestTime      String?             // HH:MM format

  // Notification Types
  notifyOnJobMatches    Boolean       @default(true)
  notifyOnApplicationUpdates Boolean  @default(true)
  notifyOnInterviewScheduled Boolean @default(true)
  notifyOnDeadline      Boolean       @default(true)
  notifyOnSecurityAlert Boolean       @default(true)

  // Quiet Hours
  quietHoursStart String?             // HH:MM
  quietHoursEnd   String?             // HH:MM
  timezone        String              @default("America/Sao_Paulo")

  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

// Enums for Notification System
enum NotificationType {
  WELCOME
  PASSWORD_RESET
  JOB_MATCH
  APPLICATION_STATUS
  INTERVIEW_SCHEDULED
  DEADLINE_REMINDER
  SECURITY_ALERT
  SYSTEM_MAINTENANCE
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum QueueStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
  COMPLAINED
}

enum NotificationFrequency {
  IMMEDIATE
  DIGEST
  DAILY
  WEEKLY
  NEVER
}
