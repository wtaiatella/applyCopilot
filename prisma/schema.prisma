datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum BulletType {
  BULLET
  PARAGRAPH
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  password           String
  role               Role                 @default(USER)
  createdAt          DateTime             @default(now())
  profile            UserProfile?
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  aiUsageLogs        AIUsageLog[]
}

model UserProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Basic Information
  firstName       String?
  lastName        String?
  title           String?
  summary         String?
  location        String?
  phone           String?
  website         String?
  github          String?
  linkedin        String?
  
  // Cleaned profile representation returned by LLM (used as embedding input)
  // Kept present but unused post-014 — replaced as the AI-input role by profileFacts below
  // (see spectech.md Non-Goals: no physical drop in this migration).
  aiCleanedText   String?          @db.Text

  // Structured facts extracted by LLM (Match Score v2), validated by profileFactsSchema.
  // Replaces aiCleanedText's role as the embedding-generation input.
  profileFacts    Json?

  // pgvector embedding field (stored as PostgreSQL vector) — 768d (was 512d TensorFlow.js)
  embedding       Unsupported("vector(768)")?

  // Sync tracking
  embeddingSyncedAt DateTime?

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences     Experience[]
  education       Education[]
  projects        Project[]
  skills          Skill[]
  references      Reference[]
  summaries       ProfileSummary[]
  cvs             CV[]
  jobAnalyses     JobAnalysis[]
  applications    Application[]
  jobFavorites    JobFavorite[]
  preferences     UserPreferences?
}

// --- Match Score v2 (014) ---

model UserPreferences {
  id                     String       @id @default(cuid())
  profileId              String       @unique

  seniority              String?      // "junior" | "mid" | "senior" | "lead" | "principal"
  totalYearsExperience   Int?

  acceptsContract        Boolean?     // null = indifferent, false = reject, true = accept
  acceptsFreelance       Boolean?
  acceptsOnsite          Boolean?
  acceptsHybrid          Boolean?
  acceptsRemote          Boolean?

  onlyWorldwide          Boolean?
  hasUsWorkAuth          Boolean?
  requiresVisaRelocation Boolean?

  salaryMin              Float?
  salaryCurrency         String?

  excludeKeywords        String[]     @default([])

  updatedAt              DateTime     @updatedAt

  profile                UserProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id              String             @id @default(cuid())
  profileId       String
  company         String
  position        String
  startDate       DateTime
  endDate         DateTime?
  current         Boolean            @default(false)
  freeFormContext String[]           @default([]) // Array of free-form AI context notes authored by the user
  tabLabel        String?                         // Short display name for the profile tab; does not affect company
  
  profile         UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bullets         ExperienceBullet[]
}

model ExperienceBullet {
  id           String      @id @default(cuid())
  // REM-3: optional + SetNull (was required + Cascade) so an archived bullet still referenced by
  // a CV can outlive its deleted parent Experience — mirrors CVBullet.experienceBulletId's
  // existing nullable-FK-with-SetNull pattern one level up.
  experienceId String?
  text         String
  isActive     Boolean     @default(true)
  isArchived   Boolean     @default(false)
  type         BulletType  @default(BULLET)
  sortOrder    Int         @default(0)

  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  usedInCVs    CVBullet[]
}

model Education {
  id              String            @id @default(cuid())
  profileId       String
  institution     String
  degree          String
  fieldOfStudy    String?
  startDate       DateTime
  endDate         DateTime?
  current         Boolean           @default(false)
  hideEndDate     Boolean           @default(false)
  freeFormContext String[]          @default([]) // Array of free-form AI context notes authored by the user
  tabLabel        String?                        // Short display name for the profile tab; does not affect institution
  
  profile         UserProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bullets         EducationBullet[]
}

model EducationBullet {
  id          String     @id @default(cuid())
  educationId String
  text        String
  isActive    Boolean    @default(true)
  isArchived  Boolean    @default(false)
  type        BulletType @default(BULLET)
  sortOrder   Int        @default(0)
  
  education   Education  @relation(fields: [educationId], references: [id], onDelete: Cascade)
  usedInCVs   CVBullet[]
}

model Project {
  id              String          @id @default(cuid())
  profileId       String
  name            String
  startDate       DateTime?
  endDate         DateTime?
  current         Boolean         @default(false)
  technologies    String[]        // Stored as text array in PostgreSQL
  freeFormContext String[]        @default([]) // Array of free-form AI context notes authored by the user
  tabLabel        String?                      // Short display name for the profile tab; does not affect name
  
  profile         UserProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bullets         ProjectBullet[]
}

model ProjectBullet {
  id         String     @id @default(cuid())
  projectId  String
  text       String
  isActive   Boolean    @default(true)
  isArchived Boolean    @default(false)
  type       BulletType @default(BULLET)
  sortOrder  Int        @default(0)
  
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usedInCVs  CVBullet[]
}

model Skill {
  id              String           @id @default(cuid())
  profileId       String
  name            String
  proficiency     ProficiencyLevel
  yearsExperience Int?
  isActive        Boolean          @default(true)
  isArchived      Boolean          @default(false)

  profile         UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  usedInCVs       CVBullet[]

  // @@unique([profileId, name]) removed — replaced by a partial unique index
  // (profileId, name) WHERE "isArchived" = false, added via raw SQL migration.
}

model Reference {
  id           String      @id @default(cuid())
  profileId    String
  name         String
  company      String?
  relationship String?
  email        String?
  phone        String?
  canContact   Boolean     @default(false)
  
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileSummary {
  id            String      @id @default(cuid())
  profileId     String
  title         String
  content       String
  isAIGenerated Boolean     @default(false)
  isActive      Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  profile       UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  usedInCVs     CVBullet[]
}

enum CVStatus {
  DRAFT
  APPLIED
}

model CV {
  id           String     @id @default(cuid())
  profileId    String
  jobListingId String
  name         String
  s3Key        String?
  status       CVStatus   @default(DRAFT)
  snapshotData Json
  appliedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobListing   JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  bullets      CVBullet[]
  application  Application?

  @@unique([profileId, jobListingId])
}

model CVBullet {
  id                 String            @id @default(cuid())
  cvId               String
  experienceBulletId String?
  projectBulletId    String?
  educationBulletId  String?
  summaryId          String?           // NEW — marks a ProfileSummary as used/locked by this CV
  skillId            String?           // NEW — marks a Skill as used/locked by this CV
  renderedText       String            // Persists CV bullet content even if original profile bullet is deleted

  cv               CV                @relation(fields: [cvId], references: [id], onDelete: Cascade)
  experienceBullet ExperienceBullet? @relation(fields: [experienceBulletId], references: [id], onDelete: SetNull)
  projectBullet    ProjectBullet?    @relation(fields: [projectBulletId], references: [id], onDelete: SetNull)
  educationBullet  EducationBullet?  @relation(fields: [educationBulletId], references: [id], onDelete: SetNull)
  summary          ProfileSummary?   @relation(fields: [summaryId], references: [id], onDelete: SetNull)
  skill            Skill?            @relation(fields: [skillId], references: [id], onDelete: SetNull)

  // Application-level invariant (also enforced via raw-SQL CHECK in the migration, see
  // Migration & Rollback): exactly one of experienceBulletId/projectBulletId/educationBulletId/
  // summaryId/skillId is non-null per row.
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  key   String @id
  value String
}

model AIUsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "parse" or "summary"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ScrapeTaskType {
  LIST
  DEEP
}

enum ScrapeTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PortalStatus {
  ACTIVE
  BROKEN
  DISABLED
}

model ScrapeTask {
  id           String           @id @default(cuid())
  type         ScrapeTaskType
  portalId     String
  status       ScrapeTaskStatus @default(PENDING)
  progress     Int              @default(0)
  resultsCount Int              @default(0)
  attempts     Int              @default(0)
  errorMessage String?

  searchUrl    String?
  keywords     String?
  location     String?
  triggeredBy  String?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model PortalSearchUrl {
  id              String       @id @default(cuid())
  portalId        String
  url             String
  name            String
  isActive        Boolean      @default(true)
  status          PortalStatus @default(ACTIVE)
  isRobotsBlocked Boolean      @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model JobListing {
  id                       String    @id @default(cuid())
  portalId                 String
  externalJobId            String
  title                    String
  company                  String
  location                 String[]  @default([])
  url                      String
  isFullDescriptionFetched Boolean   @default(false)
  fullDescription          String?   @db.Text

  // Technical summary returned by LLM (used as embedding input)
  // Kept present but unused post-014 — replaced as the AI-input role by jobFacts below
  // (see spectech.md Non-Goals: no physical drop in this migration).
  cleanedSummary           String?   @db.Text

  // Structured facts extracted by LLM (Match Score v2), validated by jobFactsSchema.
  // Replaces cleanedSummary's role as the embedding-generation input.
  jobFacts                 Json?

  // 768-dimension vector, provider-routed (was 512d TensorFlow.js) (pgvector)
  embedding                Unsupported("vector(768)")?

  // Classification State Tracking
  classificationStatus     ClassificationStatus @default(PENDING)
  classificationAttempts   Int                  @default(0)
  classificationError      String?

  locationType             String?
  countries                String[]  @default([])
  jobType                  String?
  experienceLevel          String?
  postedAt                 DateTime?
  salaryMin                Float?
  salaryMax                Float?
  currency                 String?

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  analyses                 JobAnalysis[]
  cvs                      CV[]
  applications             Application[]
  favorites                JobFavorite[]

  @@unique([portalId, externalJobId])
}

// Enum for job classification status tracking
enum ClassificationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Enum for candidacy AI recommendation verdict
enum RecommendationVerdict {
  APPLY
  CAUTION
  IGNORE
}

model JobAnalysis {
  id            String                @id @default(cuid())
  profileId     String
  jobId         String                // 1-to-1 cache per (profile, job) — see @@unique below

  // LLM generated detailed matching points
  strengths     String[]              @default([]) // Strengths matching profile
  weaknesses    String[]              @default([]) // Weaknesses / Misalignments
  missingSkills String[]              @default([]) // Skills required by job but missing on profile

  // Recommendation details
  verdict       RecommendationVerdict @default(CAUTION)
  justification String                @db.Text

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Relations
  profile       UserProfile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job           JobListing            @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobId])
}

// --- Application Tracker (009) ---

enum ApplicationStage {
  APPLIED
  SCREENING
  TECH_INTERVIEW
  OFFER
  FINAL
}

enum ApplicationOutcome {
  NOT_APPROVED
  NO_RESPONSE
  DECLINED_BY_COMPANY
  DECLINED_BY_CANDIDATE
  HIRED
}

enum ApplicationEventType {
  STAGE_CHANGE
  NOTE
  MEETING
  COMPANY_RESPONSE
}

model Application {
  id           String              @id @default(cuid())
  cvId         String              @unique   // 1:1 with CV — see spectech.md Technical Decisions
  profileId    String                          // denormalized, mirrors CV.profileId (query convenience)
  jobListingId String                          // denormalized, mirrors CV.jobListingId
  stage        ApplicationStage    @default(APPLIED)
  outcome      ApplicationOutcome?             // set only while stage = FINAL (FR-6)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  cv         CV          @relation(fields: [cvId], references: [id], onDelete: Cascade)
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobListing JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  events     ApplicationEvent[]

  @@index([profileId, stage])
}

model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  type          ApplicationEventType
  fromStage     ApplicationStage?    // STAGE_CHANGE only
  toStage       ApplicationStage?    // STAGE_CHANGE only
  title         String?              // MEETING only
  eventAt       DateTime?            // MEETING only — candidate-entered meeting date/time (display field only)
  content       String?              @db.Text // NOTE / COMPANY_RESPONSE required; MEETING optional notes
  createdAt     DateTime             @default(now()) // authoritative chronological-order field for ALL types
  // REM-4: captures the `outcome` value being cleared when a STAGE_CHANGE moves the Application
  // out of FINAL, so undoTransition has something to restore.
  previousOutcome ApplicationOutcome?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Application-level invariant (also enforced via raw-SQL CHECK in the migration, see
  // Migration & Rollback): STAGE_CHANGE requires toStage set and title/eventAt/content null;
  // NOTE/COMPANY_RESPONSE require content set and fromStage/toStage/title/eventAt null;
  // MEETING requires title+eventAt set and fromStage/toStage null.
  @@index([applicationId, createdAt])
}

model JobFavorite {
  id           String   @id @default(cuid())
  profileId    String
  jobListingId String
  createdAt    DateTime @default(now())

  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobListing JobListing  @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([profileId, jobListingId])
}

// --- Match Score Precision (015) ---

enum SkillKind {
  HARD
  SOFT
}

model SkillEmbedding {
  skill       String    @id @db.VarChar(100)          // lowercase lookup key, e.g. "postgresql"
  displayName String                                  // commercial capitalization, e.g. "PostgreSQL"
  kind        SkillKind
  embedding   Unsupported("vector(768)")
  createdAt   DateTime  @default(now())

  aliases     SkillAlias[]
}

model SkillAlias {
  alias     String          @id @db.VarChar(100)       // lowercase, e.g. "react.js"
  skill     String
  skillRef  SkillEmbedding  @relation(fields: [skill], references: [skill], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

